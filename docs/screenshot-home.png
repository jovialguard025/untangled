<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" fill="none">
  <rect width="800" height="500" rx="8" fill="#f6f5f9" stroke="#dedce5"/>

  <!-- Header -->
  <rect y="0" width="800" height="60" fill="#f6f5f9"/>
  <line x1="40" y1="60" x2="760" y2="60" stroke="#dedce5"/>
  <text x="40" y="38" font-family="system-ui" font-size="22" font-weight="800" fill="#242428" letter-spacing="-1">c• clearing</text>
  <text x="380" y="38" font-family="system-ui" font-size="13" fill="#74727b">The approach</text>
  <text x="490" y="38" font-family="system-ui" font-size="13" fill="#74727b">My thinking</text>
  <circle cx="568" cy="33" r="10" fill="#e9e6ef"/>
  <text x="564" y="37" font-family="system-ui" font-size="11" fill="#242428">0</text>

  <!-- Hero Section -->
  <text x="60" y="120" font-family="system-ui" font-size="10" fill="#7161aa" letter-spacing="2">— A SPACE TO THINK THINGS THROUGH</text>
  <text x="60" y="175" font-family="system-ui" font-size="52" font-weight="500" fill="#242428" letter-spacing="-3">A tangled mind.</text>
  <text x="60" y="235" font-family="system-ui" font-size="52" font-weight="500" fill="#242428" letter-spacing="-3">A <tspan fill="#7161aa" font-style="italic" font-family="Georgia">clearer</tspan> way.</text>
  <text x="60" y="275" font-family="system-ui" font-size="15" fill="#74727b">Big decisions. Everyday dilemmas.</text>
  <text x="60" y="295" font-family="system-ui" font-size="15" fill="#74727b">Find your way through, one good question at a time.</text>

  <!-- CTA Button -->
  <rect x="60" y="320" width="200" height="48" rx="7" fill="#242428"/>
  <text x="100" y="349" font-family="system-ui" font-size="14" fill="white">Untangle a decision</text>

  <!-- Cards -->
  <rect x="60" y="400" width="220" height="80" rx="9" fill="none" stroke="#dedce5"/>
  <text x="75" y="425" font-family="system-ui" font-size="10" fill="#74727b">⌘ WORK &amp; DIRECTION</text>
  <text x="75" y="450" font-family="system-ui" font-size="14" font-weight="500" fill="#242428">Should I stay, or take</text>
  <text x="75" y="468" font-family="system-ui" font-size="14" font-weight="500" fill="#242428">the new opportunity?</text>

  <rect x="290" y="400" width="220" height="80" rx="9" fill="none" stroke="#dedce5"/>
  <text x="305" y="425" font-family="system-ui" font-size="10" fill="#74727b">◷ TIME &amp; ENERGY</text>
  <text x="305" y="450" font-family="system-ui" font-size="14" font-weight="500" fill="#242428">Too much to do.</text>
  <text x="305" y="468" font-family="system-ui" font-size="14" font-weight="500" fill="#242428">What actually matters?</text>

  <rect x="520" y="400" width="220" height="80" rx="9" fill="none" stroke="#dedce5"/>
  <text x="535" y="425" font-family="system-ui" font-size="10" fill="#74727b">◇ MONEY &amp; PRIORITIES</text>
  <text x="535" y="450" font-family="system-ui" font-size="14" font-weight="500" fill="#242428">Do I need this,</text>
  <text x="535" y="468" font-family="system-ui" font-size="14" font-weight="500" fill="#242428">or do I just want it?</text>
</svg>
